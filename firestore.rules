rules_version = '2';

// ExpenseTracker Firestore security rules
//
// Replaces the open "test mode" rules. Each user can only read or write their
// own documents — every document carries a userId field and only the matching
// authenticated user is allowed access.
//
// Deploy:
//   1. Install the Firebase CLI:           npm install -g firebase-tools
//   2. Sign in:                             firebase login
//   3. Initialise once (pick this project): firebase init firestore
//        - When asked for the rules file, choose firestore.rules
//        - Skip indexes file unless you need it
//   4. Deploy the rules:                    firebase deploy --only firestore:rules
//
// Or paste the contents of this file into:
//   Firebase Console → Firestore Database → Rules → Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // True for reads — including `get` on a document that doesn't exist
    // (e.g. fetching a budget the user hasn't set yet). When the doc is
    // missing, `resource` is null and we let the SDK return an empty snapshot.
    function canRead() {
      return isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // For mutations on existing docs.
    function ownsExisting() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // For create/update — the incoming doc must be stamped with the caller's uid.
    function ownsIncoming() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /expenses/{doc} {
      allow read:   if canRead();
      allow delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /budgets/{doc} {
      allow read:   if canRead();
      allow delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /savingsGoals/{doc} {
      allow read:   if canRead();
      allow delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /debts/{doc} {
      allow read:   if canRead();
      allow delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
